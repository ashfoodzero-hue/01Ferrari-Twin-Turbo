    "promotion:review": "node scripts/promotion_review.mjs",
    "freshness": "node scripts/freshness_audit.mjs",
    "import:1m": "node scripts/import_history_1m.mjs",
    "stream": "node --max-old-space-size=1024 scripts/run_stream.mjs",
    "smoke:stream": "node scripts/smoke_tick_stream.mjs",
    "cache:candidates": "node --max-old-space-size=8192 scripts/cache_candidates_15m.mjs",
    "reconcile": "node --max-old-space-size=4096 scripts/reconcile_1m.mjs",
    "smoke:radar": "node --max-old-space-size=6144 scripts/smoke_level_radar.mjs",
    "validate:levelfade": "node --max-old-space-size=8192 scripts/validate_level_fade_book.mjs",
    "smoke:watchdog": "node scripts/smoke_watchdog.mjs",
