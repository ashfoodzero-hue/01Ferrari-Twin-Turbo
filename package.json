    "smoke:parity": "node --max-old-space-size=6144 scripts/smoke_twin_parity.mjs",
    "smoke:readiness": "node --max-old-space-size=4096 scripts/smoke_readiness.mjs",
    "smoke:paper": "node scripts/smoke_paper_trader.mjs",
    "smoke:review": "node scripts/smoke_paper_review.mjs",
    "smoke:trial": "node scripts/smoke_trial_journal.mjs",
    "smoke:seq": "node scripts/smoke_seq_resolver.mjs",
    "smoke:execution": "node scripts/smoke_execution.mjs",
    "smoke:prosignal": "node --max-old-space-size=4096 scripts/smoke_pro_signal.mjs",
    "smoke:marketstate": "node --max-old-space-size=4096 scripts/smoke_market_state.mjs",
    "smoke:regimesplitter": "node --max-old-space-size=4096 scripts/smoke_regime_splitter.mjs",
    "smoke:freshness": "node scripts/smoke_freshness.mjs",
    "smoke:netresolve": "node scripts/smoke_netresolve.mjs",
    "smoke:temporal": "node scripts/smoke_temporal_guarantee.mjs",
    "smoke:impulsefrozen": "node --max-old-space-size=8192 scripts/smoke_impulse_frozen.mjs",
    "validate:impulse": "node --max-old-space-size=8192 scripts/validate_impulse_cont_ship.mjs",
    "validate:impulse:seq": "set TURBO_SEQ_GATE=1&& node --max-old-space-size=8192 scripts/validate_impulse_cont_ship.mjs",
    "study:stategate": "node --max-old-space-size=8192 scripts/study_state_gate_on_impulse.mjs",
    "study:belock": "node --max-old-space-size=8192 scripts/study_be_lock_semantics.mjs",
